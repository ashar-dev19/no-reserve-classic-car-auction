# Required in production. Sessions are signed with this; without it the app
# falls back to a secret that is published in the source, and anyone can forge
# an administrator cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Where the SQLite database lives. In a container this must point at the
# mounted volume, or the data is lost on every redeploy.
DATABASE_PATH=/data/auction.db

# Set to "force" to rebuild the demo catalogue on the next container start.
# Leave unset in normal operation. Useful for resetting countdowns before a
# presentation; it deletes all bids and accounts.
# SEED_ON_START=force
